# Required for local `npm run fetch:rankings` (FantasyPros consensus rankings).
# CI uses the GitHub Actions secret FANTASYPROS_API_KEY — do not commit real keys.
FANTASYPROS_API_KEY=

# Optional: Supabase cloud sync (same leagues on laptop + phone).
# Create a project at https://supabase.com, run supabase/schema.sql, then add:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
